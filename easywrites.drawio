                </mxCell>
                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% --- TRACK 1: INITIAL ONBOARDING &amp; SIGNUP ---\n    Start([User Visits App First Time]) --&gt; Onboarding[Show Welcome Screen]\n    Onboarding --&gt; ConsentChoice{Include Local AI Sorting in Setup?}\n    \n    ConsentChoice -- \&quot;Yes / Opt-In\&quot; --&gt; SetGranted[Set localStorage: autoCategorize = &#39;GRANTED&#39;]\n    ConsentChoice -- \&quot;No / Skip\&quot; --&gt; SetUndecided[Set localStorage: autoCategorize = &#39;UNDECIDED&#39;]\n    \n    SetGranted --&gt; Workspace[Load Main Workspace Dashboard]\n    SetUndecided --&gt; Workspace\n\n    %% --- TRACK 2: RETURNING USER LOGIN FLOW ---\n    Login([Returning User Opens App]) --&gt; CheckStorage{Check localStorage: autoCategorize}\n    CheckStorage -- \&quot;Exists (&#39;GRANTED&#39; or &#39;DENIED&#39;)\&quot; --&gt; Workspace\n    CheckStorage -- \&quot;Missing (Legacy User)\&quot; --&gt; SetLegacyUndecided[Set localStorage: autoCategorize = &#39;UNDECIDED&#39;]\n    SetLegacyUndecided --&gt; Workspace\n\n    %% --- TRACK 3: CORE EDITING &amp; BACKGROUND CONTEXT RUN ---\n    Workspace --&gt; UserAction[User Clicks &#39;+ New Note&#39; or Edits Text]\n    UserAction --&gt; SaveLocal[Save Raw Note Content instantly to Dexie.js Database]\n    SaveLocal --&gt; Debounce[Wait for 1000ms User Typing Silence]\n    \n    Debounce --&gt; EvaluateConsent{Check localStorage: autoCategorize}\n    \n    %% Handling States\n    EvaluateConsent -- \&quot;&#39;GRANTED&#39;\&quot; --&gt; RunNLP[Execute Browser-Native NLP / Keyword Extraction]\n    EvaluateConsent -- \&quot;&#39;DENIED&#39;\&quot; --&gt; StayManual[Maintain strictly Manual Workspace. End Run.]\n    EvaluateConsent -- \&quot;&#39;UNDECIDED&#39;\&quot; --&gt; InterceptPopup[Trigger &#39;Smart Categorization&#39; Consent Overlay Modal]\n\n    %% Popup Interception Logic Choices\n    InterceptPopup --&gt; PopupChoice{Did User Allow?}\n    \n    PopupChoice -- \&quot;Yes, Enable AI\&quot; --&gt; UpdateGranted[Update localStorage: autoCategorize = &#39;GRANTED&#39;]\n    UpdateGranted --&gt; RunNLP\n    \n    PopupChoice -- \&quot;No, Keep Manual\&quot; --&gt; UpdateDenied[Update localStorage: autoCategorize = &#39;DENIED&#39;]\n    UpdateDenied --&gt; ClosePopup[Close Overlay Modal &amp; Never Ask Again]\n    ClosePopup --&gt; StayManual\n\n    %% Finalizing the NLP categorization loop\n    RunNLP --&gt; CheckLocks{Has User manually deleted this category for this note before?}\n    CheckLocks -- \&quot;Yes (Join Table isLocked = true)\&quot; --&gt; IgnoreCategory[Suppress Categorization Suggestion]\n    CheckLocks -- \&quot;No\&quot; --&gt; ApplyCategory[Link Note to Category in Dexie.js noteCategories Bridge Table]\n    \n    ApplyCategory --&gt; HydrateUI[Re-render Workspace Sidebar &amp; Badges React State]\n    IgnoreCategory --&gt; HydrateUI&quot;&#xa;}" id="29">
